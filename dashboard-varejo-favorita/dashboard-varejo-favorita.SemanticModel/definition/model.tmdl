model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["dim_calendario","dim_familia","dim_loja","fato_transacoes","fato_vendas","_Medidas"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_calendario
ref table dim_familia
ref table dim_loja
ref table fato_transacoes
ref table fato_vendas
ref table _Medidas

ref cultureInfo pt-BR

